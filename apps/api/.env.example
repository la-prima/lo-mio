# Para correr la API fuera del clúster (`pnpm start`). Copiar a .env (ignorado por git).
# Postgres del clúster local: kubectl port-forward -n lo-mio svc/lo-mio-db-rw 5432
# (la contraseña está en el Secret lo-mio-db-app).
DATABASE_URL=postgres://lomio:CAMBIAR@localhost:5432/lomio
# HOST=0.0.0.0
# PORT=3000
# LOG_LEVEL=info
# Orígenes permitidos para CORS, separados por coma.
# CORS_ORIGINS=http://localhost:5173
