{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/api": {
      "entry": ["src/migrate.ts", "src/seed.ts"]
    },
    ".": {
      "entry": [
        "allurerc.mjs",
        "tests/contract/labels.ts",
        "tests/allure/maestro.ts",
        "scripts/prune-store.ts"
      ]
    },
    "apps/mobile": {
      "entry": ["plugins/*.js"]
    }
  },
  "ignoreIssues": {
    "**/generated/**": ["exports", "types", "duplicates"]
  }
}
