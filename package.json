{
  "name": "lo-mio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "lefthook install",
    "check": "biome check .",
    "fix": "biome check --write .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run --project unit",
    "deadcode": "knip",
    "spec": "openspec validate --all --strict --no-interactive",
    "verify": "pnpm contracts:check && pnpm check && pnpm typecheck && pnpm test && pnpm deadcode && pnpm spec && pnpm --filter @lo-mio/guest-web build",
    "test:int": "vitest run --project integration",
    "contracts": "node scripts/contracts.ts",
    "contracts:check": "node scripts/contracts.ts --check",
    "test:contract": "tests/contract/run.sh",
    "test:flows": "tests/flows/run.sh",
    "test:e2e": "apps/guest-web/e2e/run.sh",
    "report": "allure generate reports/allure-results"
  },
  "devDependencies": {
    "@asyncapi/parser": "^3.6.4",
    "@biomejs/biome": "^2.5.15",
    "@fission-ai/openspec": "^1.14.1",
    "@redocly/cli": "^2.63.0",
    "@types/node": "^26.6.5",
    "allure": "^3.20.1",
    "allure-js-commons": "^3.13.0",
    "allure-vitest": "^3.13.0",
    "knip": "^6.41.0",
    "lefthook": "^2.2.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  }
}
